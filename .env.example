STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Stripe Price IDs (create these in your Stripe dashboard)
STRIPE_PRICE_ID_CLASSIC_MONTHLY=price_xxx
STRIPE_PRICE_ID_CLASSIC_ANNUAL=price_xxx
STRIPE_PRICE_ID_PREMIUM_MONTHLY=price_xxx
STRIPE_PRICE_ID_PREMIUM_ANNUAL=price_xxx
STRIPE_PRICE_ID_ELITE_MONTHLY=price_xxx
STRIPE_PRICE_ID_ELITE_ANNUAL=price_xxx

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=noreply@cigarcitylounge.com

# Admin
ADMIN_EMAIL=admin@cigarcitylounge.com

# QR Code Security
QR_SECRET=your-super-secret-qr-signing-key-change-this

# POS Integration
POS_API_KEY=your-pos-api-key
